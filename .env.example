# Public URL of this app. Used as the OIDC issuer and for mailer links.
APP_URL=http://localhost:3000
# FRONTEND_URL=

DATABASE_URL=postgresql://youthacks_auth:auth@localhost:5432/auth_development

# Required in production. Generate with `rails secret`.
# In development/test Rails derives this from config/master.key.
# SECRET_KEY_BASE=

# Only needed where real email delivery is configured (production).
SMTP_HOST=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Youthacks Auth <auth@youthacks.org>
