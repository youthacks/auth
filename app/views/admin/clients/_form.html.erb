<% if client.errors.any? %>
  <div role="alert" class="mb-4 rounded-lg border border-red-300 bg-red-50 p-3 text-sm text-red-800">
    <ul class="list-disc pl-5">
      <% client.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<%= form_with model: client, scope: :client, url: url, class: "space-y-4" do |f| %>
  <div>
    <%= f.label :name, class: "text-sm font-semibold text-neutral-700" %>
    <%= f.text_field :name, required: true, placeholder: "e.g. My App", class: input_classes("text-sm") %>
  </div>

  <div>
    <%= f.label :redirect_uri, "Redirect URIs", class: "text-sm font-semibold text-neutral-700" %>
    <%= f.text_area :redirect_uri, value: redirect_uris_for(client).join("\n"), required: true, rows: 4,
          placeholder: "https://example.com/oauth/callback", class: input_classes("text-sm") %>
    <p class="mt-2 text-xs text-neutral-500">Enter one callback URL per line. Clients are always confidential and get the <code><%= Doorkeeper.configuration.default_scopes.to_s %></code> scopes.</p>
  </div>

  <div class="flex items-center gap-4">
    <%= f.submit submit_label, class: "rounded-lg bg-red-700 px-4 py-2 text-sm font-semibold text-white transition hover:bg-red-800", data: { turbo_submits_with: "Saving..." } %>
    <%= link_to "Cancel", admin_clients_path, class: "text-sm font-semibold text-neutral-600 hover:text-neutral-900" %>
  </div>
<% end %>
