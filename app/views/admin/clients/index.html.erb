<% content_for :title, "Admin Clients" %>
<section class="mx-auto max-w-6xl px-6 py-12">
  <div class="mb-8 flex items-end justify-between gap-4">
    <div>
      <p class="text-xs font-semibold uppercase tracking-widest text-red-700">Admin</p>
      <h1 class="mt-2 text-3xl font-semibold text-neutral-900">OAuth Applications</h1>
      <p class="mt-2 text-neutral-600">Create, edit, and remove allowed OAuth clients.</p>
    </div>
    <%= link_to "New application", new_admin_client_path, class: "rounded-lg bg-red-700 px-4 py-2 text-sm font-semibold text-white transition hover:bg-red-800" %>
  </div>

  <div class="rounded-xl border border-neutral-200 bg-white p-6 shadow-sm">
    <% if @clients.empty? %>
      <p class="text-sm text-neutral-500">No applications yet.</p>
    <% else %>
      <div class="overflow-x-auto">
        <table class="w-full border-collapse text-left text-sm">
          <thead>
            <tr class="border-b border-neutral-200 text-xs uppercase tracking-wide text-neutral-500">
              <th class="py-2 pr-4">Name</th>
              <th class="py-2 pr-4">Client ID</th>
              <th class="py-2 pr-4">Redirect URIs</th>
              <th class="py-2 pr-4">Scopes</th>
              <th class="py-2 pr-4">Created</th>
              <th class="py-2">Actions</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-neutral-100">
            <% @clients.each do |client| %>
              <tr class="text-sm text-neutral-700">
                <td class="py-3 pr-4 font-semibold text-neutral-900"><%= link_to client.name, admin_client_path(client), class: "hover:underline" %></td>
                <td class="py-3 pr-4 font-mono text-xs text-neutral-600"><%= client.uid %></td>
                <td class="py-3 pr-4 text-neutral-600">
                  <% redirect_uris_for(client).each do |uri| %>
                    <div class="break-all"><%= uri %></div>
                  <% end %>
                </td>
                <td class="py-3 pr-4 text-neutral-600"><%= client.scopes.to_s.presence || "-" %></td>
                <td class="py-3 pr-4 text-neutral-600"><%= client.created_at.to_date %></td>
                <td class="py-3 whitespace-nowrap">
                  <%= link_to "Edit", edit_admin_client_path(client), class: "mr-3 text-sm font-semibold text-red-700 hover:text-red-800" %>
                  <%= button_to "Delete", admin_client_path(client), method: :delete, form_class: "inline",
                        class: "text-sm font-semibold text-neutral-600 hover:text-neutral-900",
                        data: { turbo_confirm: "Delete #{client.name}? Existing tokens for it will stop working." } %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>
  </div>
</section>
