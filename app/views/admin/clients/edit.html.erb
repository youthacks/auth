<% content_for :title, "Edit Client" %>
<section class="mx-auto max-w-2xl px-6 py-12">
  <p class="text-xs font-semibold uppercase tracking-widest text-red-700">Admin</p>
  <h1 class="mt-2 mb-6 text-3xl font-semibold text-neutral-900">Edit <%= @client.name %></h1>
  <div class="rounded-xl border border-neutral-200 bg-white p-6 shadow-sm">
    <%= render "form", client: @client, url: admin_client_path(@client), submit_label: "Save changes" %>
  </div>
</section>
