<% content_for :title, "New Client" %>
<section class="mx-auto max-w-2xl px-6 py-12">
  <p class="text-xs font-semibold uppercase tracking-widest text-red-700">Admin</p>
  <h1 class="mt-2 mb-6 text-3xl font-semibold text-neutral-900">Create Application</h1>
  <div class="rounded-xl border border-neutral-200 bg-white p-6 shadow-sm">
    <%= render "form", client: @client, url: admin_clients_path, submit_label: "Create application" %>
  </div>
</section>
