<% content_for :title, "Not Found" %>
<div class="flex min-h-[60vh] items-center justify-center p-8">
  <div class="text-center">
    <p class="text-xs font-semibold uppercase tracking-widest text-red-700">404</p>
    <h1 class="mt-2 text-4xl font-bold">Page not found</h1>
    <p class="mt-2 text-neutral-600">The page you're looking for doesn't exist.</p>
    <%= link_to "Go back home", root_path, class: "mt-8 inline-block rounded-lg bg-red-800 px-6 py-3 font-semibold text-white transition hover:bg-red-900" %>
  </div>
</div>
