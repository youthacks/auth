<div class="p-8">
  <div class="mx-auto max-w-4xl">
    <div class="rounded-xl border border-neutral-300 bg-white p-8 shadow-sm">
      <div class="flex items-center justify-between">
        <h1 class="text-3xl font-bold"><%= t(".title") %></h1>
        <%= link_to t(".new"), new_oauth_application_path,
              class: "rounded-lg bg-red-800 px-4 py-2 font-semibold text-white transition hover:bg-red-900" %>
      </div>

      <div class="mt-8 overflow-hidden rounded-lg border border-neutral-200">
        <table class="w-full text-left text-sm">
          <thead class="bg-neutral-50 text-neutral-500">
            <tr>
              <th class="px-4 py-3 font-semibold"><%= t(".name") %></th>
              <th class="px-4 py-3 font-semibold"><%= t(".callback_url") %></th>
              <th class="px-4 py-3 font-semibold"><%= t(".confidential") %></th>
              <th class="px-4 py-3"></th>
              <th class="px-4 py-3"></th>
            </tr>
          </thead>
          <tbody class="divide-y divide-neutral-200">
            <% @applications.each do |application| %>
              <tr id="application_<%= application.id %>">
                <td class="px-4 py-3">
                  <%= link_to application.name, oauth_application_path(application), class: "font-semibold text-red-800 hover:underline" %>
                </td>
                <td class="px-4 py-3 text-neutral-600"><%= application.redirect_uri %></td>
                <td class="px-4 py-3 text-neutral-600">
                  <%= application.confidential? ? t("doorkeeper.applications.index.confidentiality.yes") : t("doorkeeper.applications.index.confidentiality.no") %>
                </td>
                <td class="px-4 py-3">
                  <%= link_to t("doorkeeper.applications.buttons.edit"), edit_oauth_application_path(application), class: "font-semibold text-neutral-700 hover:underline" %>
                </td>
                <td class="px-4 py-3">
                  <%= render "delete_form", application: application %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>
