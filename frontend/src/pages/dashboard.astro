---
import Layout from "../layouts/Layout.astro";

if (typeof window !== 'undefined') {
  (async () => {
    const { api } = await import("../lib/api");
    const user = await api.getUser();
    if (!user) {
      const loginUrl = new URL("/login", window.location.origin);
      loginUrl.searchParams.set("return_to", window.location.href);
      window.location.href = loginUrl.toString();
    }
  })();
}
---

<Layout title="Dashboard">
  <div class="min-h-screen p-8">
    <div class="mx-auto max-w-4xl">
      <div class="rounded-xl border border-neutral-300 bg-white p-8 shadow-sm">
        <div class="flex items-center justify-between">
          <div>
            <div class="flex items-center gap-3">
              <h1 class="font-satoshi text-3xl font-bold">Dashboard</h1>
              <span id="admin-badge" class="hidden rounded-md bg-yellow-400 px-3 py-1 text-sm font-bold text-black">ADMIN</span>
            </div>
            <p id="welcome" class="mt-2 text-neutral-600">Welcome back!</p>
          </div>
          <button
            id="logout-btn"
            class="rounded-lg border border-neutral-300 px-4 py-2 font-semibold text-neutral-700 transition hover:bg-neutral-50"
          >
            Logout
          </button>
        </div>

        <div id="notice" class="mt-6 hidden rounded-lg border border-red-200 bg-red-50 p-3 text-sm text-red-800"></div>

        <div id="user-info" class="mt-8 space-y-4 rounded-lg border border-neutral-200 bg-neutral-50 p-6">
          <div class="grid grid-cols-2 gap-4">
            <div>
              <p class="text-sm font-semibold text-neutral-500">Name</p>
              <p id="name" class="mt-1 text-lg">-</p>
            </div>
            <div>
              <p class="text-sm font-semibold text-neutral-500">Username</p>
              <p id="username" class="mt-1 text-lg">-</p>
            </div>
            <div>
              <p class="text-sm font-semibold text-neutral-500">Email</p>
              <p id="email" class="mt-1 text-lg">-</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>

<script>
  import { api } from "../lib/api";
  import { consumeFlash } from "../lib/flash";

  const logoutBtn = document.getElementById("logout-btn") as HTMLButtonElement;
  const welcomeP = document.getElementById("welcome") as HTMLParagraphElement;
  const noticeDiv = document.getElementById("notice") as HTMLDivElement;
  const adminBadge = document.getElementById("admin-badge") as HTMLSpanElement;
  const nameP = document.getElementById("name") as HTMLParagraphElement;
  const usernameP = document.getElementById("username") as HTMLParagraphElement;
  const emailP = document.getElementById("email") as HTMLParagraphElement;

  const flash = consumeFlash();
  if (flash) {
    noticeDiv.textContent = flash.text;
    noticeDiv.classList.remove("hidden");

    const isError = flash.type === "error";
    noticeDiv.classList.toggle("border-red-200", isError);
    noticeDiv.classList.toggle("bg-red-50", isError);
    noticeDiv.classList.toggle("text-red-800", isError);

    noticeDiv.classList.toggle("border-neutral-200", !isError);
    noticeDiv.classList.toggle("bg-neutral-50", !isError);
    noticeDiv.classList.toggle("text-neutral-700", !isError);
  }

  // Check authentication and fetch user info
  (async () => {
    const user = await api.getUser();
    if (!user) {
      const loginUrl = new URL("/login", window.location.origin);
      loginUrl.searchParams.set("return_to", window.location.href);
      window.location.href = loginUrl.toString();
      return;
    }
    welcomeP.textContent = `Welcome back, ${user.preferred_name || user.first_name}!`;
    nameP.textContent = `${user.first_name} ${user.last_name}`;
    usernameP.textContent = user.username;
    if (user.admin) {
      adminBadge.classList.remove("hidden");
    }
    emailP.textContent = user.email;
  })();

  logoutBtn.addEventListener("click", async () => {
    logoutBtn.disabled = true;
    logoutBtn.textContent = "Logging out...";

    await api.logout();
    window.location.href = "/login";
  });
</script>
