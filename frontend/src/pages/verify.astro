---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Verify Email">
  <div class="flex min-h-screen items-center justify-center p-8">
    <div class="w-full max-w-md">
      <div class="rounded-xl border border-neutral-300 bg-white p-8 shadow-sm">
        <h1 class="font-satoshi text-3xl font-bold">Verify your email</h1>
        <p class="mt-2 text-neutral-600">Enter the code sent to your email</p>

        <div id="error" class="mt-4 hidden rounded-lg border border-red-300 bg-red-50 p-3 text-sm text-red-800"></div>
        <div id="success" class="mt-4 hidden rounded-lg border border-green-300 bg-green-50 p-3 text-sm text-green-800"></div>

        <form id="verify-form" class="mt-6 space-y-4">
          <div>
            <label for="email" class="block text-sm font-semibold text-neutral-700">
              Email
            </label>
            <input
              type="email"
              id="email"
              name="email"
              required
              class="mt-1 w-full rounded-lg border border-neutral-300 px-4 py-2 transition focus:border-red-500 focus:outline-none focus:ring-2 focus:ring-red-500/20"
            />
          </div>

          <div>
            <label for="code" class="block text-sm font-semibold text-neutral-700">
              Verification Code
            </label>
            <input
              type="text"
              id="code"
              name="code"
              required
              class="mt-1 w-full rounded-lg border border-neutral-300 px-4 py-2 font-mono text-lg tracking-wider transition focus:border-red-500 focus:outline-none focus:ring-2 focus:ring-red-500/20"
              placeholder="000000"
              maxlength="6"
            />
          </div>

          <button
            type="submit"
            class="w-full rounded-lg bg-red-800 py-3 font-semibold text-white transition hover:bg-red-900"
          >
            Verify email
          </button>

          <button
            type="button"
            id="resend-btn"
            class="w-full rounded-lg border border-neutral-300 py-3 font-semibold text-neutral-700 transition hover:bg-neutral-50"
          >
            Resend code
          </button>
        </form>

        <div class="mt-6 text-center text-sm text-neutral-600">
          <a href="/login" class="font-semibold text-red-800 underline-offset-2 transition hover:text-red-900 hover:underline">
            Back to login
          </a>
        </div>
      </div>
    </div>
  </div>
</Layout>

<script>
  import { api } from "../lib/api";

  const form = document.getElementById("verify-form") as HTMLFormElement;
  const emailInput = document.getElementById("email") as HTMLInputElement;
  const errorDiv = document.getElementById("error") as HTMLDivElement;
  const successDiv = document.getElementById("success") as HTMLDivElement;
  const resendBtn = document.getElementById("resend-btn") as HTMLButtonElement;
  const codeInput = document.getElementById("code") as HTMLInputElement;

  const normalizeEmail = (value: string | null) => value?.trim().toLowerCase() || "";

  const urlParams = new URLSearchParams(window.location.search);
  const emailFromQuery = normalizeEmail(urlParams.get("email"));
  const emailFromSession = normalizeEmail(sessionStorage.getItem("signup_email"));
  const emailFromLocal = normalizeEmail(localStorage.getItem("signup_email"));
  const fixedEmail = emailFromQuery || emailFromSession || emailFromLocal;

  if (emailFromQuery) {
    localStorage.setItem("signup_email", emailFromQuery);
    sessionStorage.setItem("signup_email", emailFromQuery);
  }

  if (fixedEmail) {
    emailInput.value = fixedEmail;
    emailInput.readOnly = true;
    emailInput.classList.add("bg-neutral-100", "text-neutral-600", "cursor-not-allowed");
  } else {
    emailInput.readOnly = true;
    emailInput.classList.add("bg-neutral-100", "text-neutral-600", "cursor-not-allowed");
    codeInput.disabled = true;
    resendBtn.disabled = true;
    errorDiv.textContent = "Missing signup email context. Please start again from sign up.";
    errorDiv.classList.remove("hidden");
  }

  form.addEventListener("submit", async (e) => {
    e.preventDefault();

    if (!fixedEmail) {
      return;
    }

    const formData = new FormData(form);
    const code = formData.get("code") as string;

    errorDiv.classList.add("hidden");
    successDiv.classList.add("hidden");

    const button = form.querySelector("button[type=submit]") as HTMLButtonElement;
    button.disabled = true;
    button.textContent = "Verifying...";

    const response = await api.verifyEmail(fixedEmail, code.trim());

    button.disabled = false;
    button.textContent = "Verify email";

    if (response.error) {
      errorDiv.textContent = response.error;
      errorDiv.classList.remove("hidden");
    } else {
      successDiv.textContent = "Email verified! Redirecting to login...";
      successDiv.classList.remove("hidden");
      localStorage.removeItem("signup_email");
      sessionStorage.removeItem("signup_email");

      const loginUrl = new URL("/login", window.location.origin);
      loginUrl.searchParams.set("identifier", fixedEmail);

      setTimeout(() => {
        window.location.href = loginUrl.toString();
      }, 1500);
    }
  });

  resendBtn.addEventListener("click", async () => {
    if (!fixedEmail) {
      errorDiv.textContent = "Missing signup email context. Please start again from sign up.";
      errorDiv.classList.remove("hidden");
      return;
    }

    errorDiv.classList.add("hidden");
    successDiv.classList.add("hidden");

    resendBtn.disabled = true;
    resendBtn.textContent = "Sending...";

    const response = await api.resendVerification(fixedEmail);

    resendBtn.disabled = false;
    resendBtn.textContent = "Resend code";

    if (response.error) {
      errorDiv.textContent = response.error;
      errorDiv.classList.remove("hidden");
    } else {
      successDiv.textContent = "Verification code sent!";
      successDiv.classList.remove("hidden");
    }
  });
</script>
