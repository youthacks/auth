---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Verify Email">
  <div class="flex min-h-screen items-center justify-center p-8">
    <div class="w-full max-w-md">
      <div class="rounded-xl border border-neutral-300 bg-white p-8 shadow-sm">
        <h1 class="font-satoshi text-3xl font-bold">Verify your email</h1>
        <p class="mt-2 text-neutral-600">Enter the code sent to your email</p>

        <div id="error" class="mt-4 hidden rounded-lg border border-red-300 bg-red-50 p-3 text-sm text-red-800"></div>
        <div id="success" class="mt-4 hidden rounded-lg border border-green-300 bg-green-50 p-3 text-sm text-green-800"></div>

        <form id="verify-form" class="mt-6 space-y-4">
          <div>
            <label for="email" class="block text-sm font-semibold text-neutral-700">
              Email
            </label>
            <input
              type="email"
              id="email"
              name="email"
              required
              class="mt-1 w-full rounded-lg border border-neutral-300 px-4 py-2 transition focus:border-red-500 focus:outline-none focus:ring-2 focus:ring-red-500/20"
            />
          </div>

          <div>
            <label for="code" class="block text-sm font-semibold text-neutral-700">
              Verification Code
            </label>
            <input
              type="text"
              id="code"
              name="code"
              required
              class="mt-1 w-full rounded-lg border border-neutral-300 px-4 py-2 font-mono text-lg tracking-wider transition focus:border-red-500 focus:outline-none focus:ring-2 focus:ring-red-500/20"
              placeholder="000000"
              maxlength="6"
            />
          </div>

          <button
            type="submit"
            class="w-full rounded-lg bg-red-800 py-3 font-semibold text-white transition hover:bg-red-900"
          >
            Verify email
          </button>

          <button
            type="button"
            id="resend-btn"
            class="w-full rounded-lg border border-neutral-300 py-3 font-semibold text-neutral-700 transition hover:bg-neutral-50"
          >
            Resend code
          </button>
        </form>

        <div class="mt-6 text-center text-sm text-neutral-600">
          <a href="/login" class="font-semibold text-red-800 underline-offset-2 transition hover:text-red-900 hover:underline">
            Back to login
          </a>
        </div>
      </div>
    </div>
  </div>
</Layout>

<script>
  import { api } from "../lib/api";

  const form = document.getElementById("verify-form") as HTMLFormElement;
  const emailInput = document.getElementById("email") as HTMLInputElement;
  const errorDiv = document.getElementById("error") as HTMLDivElement;
  const successDiv = document.getElementById("success") as HTMLDivElement;
  const resendBtn = document.getElementById("resend-btn") as HTMLButtonElement;

  // Pre-fill email from localStorage if available
  const signupEmail = localStorage.getItem("signup_email");
  if (signupEmail) {
    emailInput.value = signupEmail;
  }

  form.addEventListener("submit", async (e) => {
    e.preventDefault();

    const formData = new FormData(form);
    const email = formData.get("email") as string;
    const code = formData.get("code") as string;

    errorDiv.classList.add("hidden");
    successDiv.classList.add("hidden");

    const button = form.querySelector("button[type=submit]") as HTMLButtonElement;
    button.disabled = true;
    button.textContent = "Verifying...";

    const response = await api.verifyEmail(email, code);

    button.disabled = false;
    button.textContent = "Verify email";

    if (response.error) {
      errorDiv.textContent = response.error;
      errorDiv.classList.remove("hidden");
    } else {
      successDiv.textContent = "Email verified! Redirecting to login...";
      successDiv.classList.remove("hidden");
      localStorage.removeItem("signup_email");
      setTimeout(() => {
        window.location.href = "/login";
      }, 1500);
    }
  });

  resendBtn.addEventListener("click", async () => {
    const email = emailInput.value;
    
    if (!email) {
      errorDiv.textContent = "Please enter your email";
      errorDiv.classList.remove("hidden");
      return;
    }

    errorDiv.classList.add("hidden");
    successDiv.classList.add("hidden");

    resendBtn.disabled = true;
    resendBtn.textContent = "Sending...";

    const response = await api.resendVerification(email);

    resendBtn.disabled = false;
    resendBtn.textContent = "Resend code";

    if (response.error) {
      errorDiv.textContent = response.error;
      errorDiv.classList.remove("hidden");
    } else {
      successDiv.textContent = "Verification code sent!";
      successDiv.classList.remove("hidden");
    }
  });
</script>
