---
import Layout from "../../layouts/Layout.astro";
const apiUrl = import.meta.env.PUBLIC_API_URL || 'https://auth.youthacks.org/api';
---

<Layout title="API Documentation">
  <div id="docs" style="height: calc(100vh - 72px); width: 100%; overflow: hidden;"></div>
</Layout>

<script is:inline define:vars={{ apiUrl }}>
  // Load Stoplight Elements CSS
  const link = document.createElement('link');
  link.rel = 'stylesheet';
  link.href = 'https://unpkg.com/@stoplight/elements/styles.min.css';
  document.head.appendChild(link);

  // Load Stoplight Elements JS
  const script = document.createElement('script');
  script.src = 'https://unpkg.com/@stoplight/elements/web-components.min.js';
  script.onload = function() {
    // Wait a bit for the custom element to register
    setTimeout(() => {
      const container = document.getElementById('docs');
      if (container) {
        // Create the elements-api element
        const elementsApi = document.createElement('elements-api');
        elementsApi.setAttribute('apiDescriptionUrl', apiUrl + '/docs');
        elementsApi.setAttribute('router', 'hash');
        elementsApi.setAttribute('layout', 'sidebar');
        elementsApi.style.height = '100%';
        elementsApi.style.width = '100%';
        container.appendChild(elementsApi);
      }
    }, 100);
  };
  document.head.appendChild(script);
</script>

<style>
  body {
    margin: 0;
    padding: 0;
    overflow: hidden;
  }
</style>
