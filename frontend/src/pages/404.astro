---
import Layout from "../layouts/Layout.astro";
---

<Layout title="404 - Page Not Found">
  <div class="flex min-h-screen items-center justify-center p-8">
    <div class="w-full max-w-md">
      <div class="rounded-xl border border-neutral-300 bg-white p-8 shadow-sm text-center">
        <h1 class="font-satoshi text-6xl font-bold text-red-800">404</h1>
        <p class="mt-2 text-lg text-neutral-600">Page not found</p>
        <p class="mt-2 text-sm text-neutral-500">The page you're looking for doesn't exist or has been moved.</p>

        <a
          href="/"
          class="mt-8 inline-block rounded-lg bg-red-800 px-6 py-3 font-semibold text-white transition hover:bg-red-900"
        >
          Go back home
        </a>
      </div>
    </div>
  </div>
</Layout>
