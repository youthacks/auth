---
import Layout from "../../layouts/Layout.astro";
---

<Layout title="Authorize SSO">
  <div class="flex min-h-screen items-center justify-center p-8">
    <div class="w-full max-w-lg">
      <div class="rounded-xl border border-neutral-300 bg-white p-8 shadow-sm">
        <h1 class="font-satoshi text-2xl font-bold">Authorize access</h1>
        <p class="mt-2 text-neutral-600">This service is requesting the following information:</p>

        <div class="mt-4 rounded-lg border border-neutral-200 bg-neutral-50 p-4 text-sm text-neutral-700">
          <div class="font-semibold" id="issuer"></div>
          <div class="mt-2 text-neutral-500" id="acs"></div>
          <div class="mt-2 text-sm" id="trust"></div>
        </div>

        <ul class="mt-4 list-disc space-y-2 pl-6 text-sm text-neutral-700">
          <li>Email (NameID)</li>
          <li>First name</li>
          <li>Last name</li>
          <li>Username</li>
        </ul>

        <div class="mt-6 flex gap-3">
          <button
            id="approve"
            class="flex-1 rounded-lg bg-red-800 py-3 font-semibold text-white transition hover:bg-red-900"
          >
            Approve
          </button>
          <button
            id="deny"
            class="flex-1 rounded-lg border border-neutral-300 py-3 font-semibold text-neutral-800 transition hover:bg-neutral-50"
          >
            Deny
          </button>
        </div>

        <p class="mt-4 text-xs text-neutral-500">
          You can revoke access by signing out of Youthacks.
        </p>
      </div>
    </div>
  </div>
</Layout>

<script>
  const params = new URLSearchParams(window.location.search);
  const returnTo = params.get("return_to");
  const issuer = params.get("issuer") || "Unknown service";
  const acs = params.get("acs") || "";
  const trusted = params.get("trusted") === "true";

  const issuerEl = document.getElementById("issuer");
  const acsEl = document.getElementById("acs");
  const trustEl = document.getElementById("trust");
  const approve = document.getElementById("approve");
  const deny = document.getElementById("deny");

  if (issuerEl) issuerEl.textContent = issuer;
  if (acsEl) acsEl.textContent = acs ? `ACS: ${acs}` : "";
  if (trustEl) {
    trustEl.textContent = trusted ? "Trusted request (signed by the service)." : "Unverified request (not signed).";
    trustEl.className = trusted ? "text-green-700" : "text-red-700";
  }

  approve?.addEventListener("click", () => {
    if (!returnTo) {
      window.location.href = "/login";
      return;
    }

    const url = new URL(returnTo, window.location.origin);
    url.searchParams.set("consent", "true");
    window.location.href = url.toString();
  });

  deny?.addEventListener("click", () => {
    window.location.href = "/login";
  });
</script>
